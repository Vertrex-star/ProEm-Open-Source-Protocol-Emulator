[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 30

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
read -formal frame_buffer.sv entry_dispatch.sv entry_dispatch_formal.sv
prep -top entry_dispatch_formal
memory_map
flatten
opt -fast
setundef -anyseq

