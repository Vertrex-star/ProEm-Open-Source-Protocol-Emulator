[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 40

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
read -formal main_counter.sv main_counter_formal.sv
prep -top main_counter_formal
memory_map
flatten
connect -set peek_remaining dut.remaining
connect -set peek_clock dut.internal_clock
connect -set peek_index dut.index
connect -set peek_pending_valid dut.pending_valid
connect -set peek_pending_len dut.pending_len
connect -set peek_pending_data dut.pending_data
connect -set peek_shift dut.shift_data
connect -set peek_carry_valid dut.carry_valid
connect -set peek_carry_len dut.carry_len
connect -set peek_carry_data dut.carry_data
connect -set peek_write dut.internal_write
connect -set peek_ack_pending dut.ack_pending
connect -set peek_nack_pending dut.nack_pending
connect -set peek_ack_wait dut.ack_wait
opt -fast
setundef -anyseq

[files]
../src/core/frame_chain/main_counter.sv
main_counter_formal.sv
